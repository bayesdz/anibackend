# Через запятую. В проде укажите домен фронтенда.
ALLOWED_ORIGINS=*

# ВАЖНО в проде: ключ подписи ссылок на сегменты. Без него генерируется случайный при каждом старте
# (после перезапуска/«засыпания» хостинга ссылки в уже открытых плеерах перестанут работать).
# Сгенерировать:  python -c "import secrets; print(secrets.token_hex(32))"
SEG_SECRET=

# 1 (по умолчанию) — сегменты видео идут через бэкенд с нужным Referer (надёжно, но тратит трафик бэкенда).
# 0 — плеер качает сегменты прямо с CDN Aniboom (быстрее; работает, только если CDN не проверяет Referer).
PROXY_SEGMENTS=1
# Referer/Origin, с которыми бэкенд ходит за сегментами и плейлистами
ANIBOOM_REFERER=https://aniboom.one/

# Если animego.org недоступен с хостинга: зеркало и/или прокси (http://host:port или socks5://user:pass@host:port)
ANIMEGO_MIRROR=
ANIMEGO_PROXY=

# Ручная привязка shikimori_id:animego_id, если автоподбор ошибся (проверить: /api/aniboom/resolve?shikimori_id=ID)
# Пример: ANIMEGO_OVERRIDES=16498:2239,5114:100
ANIMEGO_OVERRIDES=
